<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- xUnit test methods intentionally use snake_case segments in names for readability. -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <RenderiteSharedDllPath Condition="'$(RenderiteSharedDllPath)' == '' and '$(RENDERITE_SHARED_DLL)' != '' and Exists('$(RENDERITE_SHARED_DLL)')">$(RENDERITE_SHARED_DLL)</RenderiteSharedDllPath>
    <RenderiteSharedDllPath Condition="'$(RenderiteSharedDllPath)' == '' and '$(RESONITE_DIR)' != '' and Exists('$(RESONITE_DIR)/Renderite.Shared.dll')">$(RESONITE_DIR)/Renderite.Shared.dll</RenderiteSharedDllPath>
    <RenderiteSharedDllPath Condition="'$(RenderiteSharedDllPath)' == '' and '$(ProgramFiles(x86))' != '' and Exists('$(ProgramFiles(x86))/Steam/steamapps/common/Resonite/Renderite.Shared.dll')">$(ProgramFiles(x86))/Steam/steamapps/common/Resonite/Renderite.Shared.dll</RenderiteSharedDllPath>
    <RenderiteSharedDllPath Condition="'$(RenderiteSharedDllPath)' == '' and '$(HOME)' != '' and Exists('$(HOME)/.steam/steam/steamapps/common/Resonite/Renderite.Shared.dll')">$(HOME)/.steam/steam/steamapps/common/Resonite/Renderite.Shared.dll</RenderiteSharedDllPath>
    <RenderiteSharedDllPath Condition="'$(RenderiteSharedDllPath)' == '' and Exists('$(MSBuildThisFileDirectory)lib/Renderite.Shared.dll')">$(MSBuildThisFileDirectory)lib/Renderite.Shared.dll</RenderiteSharedDllPath>
    <HasRenderiteSharedDll Condition="'$(RenderiteSharedDllPath)' != '' and Exists('$(RenderiteSharedDllPath)')">true</HasRenderiteSharedDll>
    <!-- GitHub Actions sets CI=true. A missing DLL must fail the build there, not omit the roundtrip sources. -->
    <RenderiteRoundtripRequired Condition="'$(CI)' == 'true' or '$(CI)' == '1'">true</RenderiteRoundtripRequired>
  </PropertyGroup>

  <Target Name="FailRoundtripWhenSharedDllMissingOnCi" BeforeTargets="BeforeBuild" Condition="'$(RenderiteRoundtripRequired)' == 'true' and '$(HasRenderiteSharedDll)' != 'true'">
    <Error Text="Renderite.Shared.dll is required when CI=true. The C#/Rust IPC roundtrip must fail instead of being omitted. Set RENDERITE_SHARED_DLL to the Release build of Yellow-Dog-Man/Renderite Renderite.Shared at commit 7ccfd2ee7c28648cb2e46dd4f52f51613a848071." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SharedTypeGenerator\SharedTypeGenerator.csproj" />
    <Reference Include="Renderite.Shared" Condition="'$(HasRenderiteSharedDll)' == 'true'">
      <HintPath>$(RenderiteSharedDllPath)</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Roundtrip sources reference Renderite.Shared types; they cannot compile without the DLL.
       Outside CI they are omitted and RenderiteSharedDllPresenceTests skips. On CI the target above fails first. -->
  <ItemGroup Condition="'$(HasRenderiteSharedDll)' != 'true'">
    <Compile Remove="Roundtrip/**/*.cs" />
  </ItemGroup>

</Project>
